#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

// The host OS does Dvorak, so everything here sends QWERTY keycodes.
// Comments name the character you actually get under OS Dvorak.
// LAYOUT.md is the human cheat sheet — update it when this file changes.

#define BASE 0
#define NUM  1
#define SYM  2
#define NAV  3
#define ADJ  4

&lt {
    quick-tap-ms = <200>;   // tap then hold Space = repeat space, not the layer
};

/ {
    behaviors {
        // Bottom-row mods: balanced + idle guard so fast typing doesn't trigger mods
        hm: home_row_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust {
            if-layers = <NUM SYM>;
            then-layer = <ADJ>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Only on pairs that are rare in Dvorak; idle guard stops mid-word misfires
        left_paren {          // p + y → (
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <4 5>;
            layers = <BASE>;
            require-prior-idle-ms = <150>;
        };

        right_paren {         // f + g → )
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <6 7>;
            layers = <BASE>;
            require-prior-idle-ms = <150>;
        };

        left_curly {          // k + x → {
            bindings = <&kp UNDER>;
            key-positions = <28 29>;
            layers = <BASE>;
            require-prior-idle-ms = <150>;
        };

        right_curly {         // b + m → }
            bindings = <&kp PLUS>;
            key-positions = <30 31>;
            layers = <BASE>;
            require-prior-idle-ms = <150>;
        };

        grave {               // ' + , → `
            bindings = <&kp GRAVE>;
            key-positions = <1 2>;
            layers = <BASE>;
            require-prior-idle-ms = <150>;
        };

        equals {              // c + r + l → =
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <8 9 10>;
            layers = <BASE>;
            require-prior-idle-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
&none  &kp Q                &kp W                &kp E               &kp R               &kp T          &kp Y          &kp U               &kp I                &kp O                &kp P                 &none
&none  &kp A                &kp S                &kp D               &kp F               &kp G          &kp H          &kp J               &kp K                &kp L                &kp SEMI              &none
&none  &hm LEFT_SHIFT Z     &hm LEFT_CONTROL X   &hm LEFT_ALT C      &hm LEFT_GUI V      &kp B          &kp N          &hm RIGHT_GUI M     &hm RIGHT_ALT COMMA  &hm RIGHT_CONTROL DOT &hm RIGHT_SHIFT SLASH  &none
                                                 &mt LEFT_SHIFT ESC  &lt NAV TAB         &lt NUM SPACE  &lt SYM SPACE  &lt NAV BACKSPACE   &mt RIGHT_SHIFT ENTER
            >;
        };

        // Numpad on both hands. Left: * 7 8 9 + / . 4 5 6 , / = 1 2 3 -   Right: - 7 8 9 / / , 4 5 6 . / + 1 2 3 =
        numbers {
            display-name = "Num";
            bindings = <
&none  &kp ASTRK          &kp N7  &kp N8  &kp N9  &kp RIGHT_BRACE      &kp SQT          &kp N7  &kp N8  &kp N9  &kp LEFT_BRACKET   &none
&none  &kp E              &kp N4  &kp N5  &kp N6  &kp W                &kp W            &kp N4  &kp N5  &kp N6  &kp E              &none
&none  &kp RIGHT_BRACKET  &kp N1  &kp N2  &kp N3  &kp SQT              &kp RIGHT_BRACE  &kp N1  &kp N2  &kp N3  &kp RIGHT_BRACKET  &none
                                  &kp N0  &trans  &trans               &trans           &trans  &kp N0
            >;
        };

        // Left:  ! @ # $ %  /  { ( ) } =  /  [ < > ] `
        // Right: ^ & * ? ~  /  - _ + / |  /  \ . . . .
        symbols {
            display-name = "Sym";
            bindings = <
&none  &kp EXCL   &kp AT      &kp HASH    &kp DOLLAR  &kp PERCENT          &kp CARET      &kp AMPS  &kp ASTRK        &kp LEFT_BRACE    &kp TILDE  &none
&none  &kp UNDER  &kp LPAR    &kp RPAR    &kp PLUS    &kp RIGHT_BRACKET    &kp SQT        &kp DQT   &kp RIGHT_BRACE  &kp LEFT_BRACKET  &kp PIPE   &none
&none  &kp MINUS  &kp LS(W)   &kp LS(E)   &kp EQUAL   &kp GRAVE            &kp BACKSLASH  &none     &none            &none             &none      &none
                              &trans      &trans      &trans               &trans         &trans    &trans
            >;
        };

        nav {
            display-name = "Nav";
            bindings = <
&none  &none     &kp UP    &none      &none   &none     &kp HOME      &kp PAGE_UP  &kp UP             &kp PAGE_DOWN    &kp END           &none
&none  &kp LEFT  &kp DOWN  &kp RIGHT  &none   &none     &caps_word    &kp LEFT     &kp DOWN           &kp RIGHT        &kp C_PLAY_PAUSE  &none
&none  &trans    &trans    &trans     &trans  &trans    &kp C_REWIND  &kp C_MUTE   &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_FF          &none
                           &trans     &trans  &trans    &trans        &trans       &trans
            >;
        };

        // Hold both Spaces. Bootloader/reset act on the half they're pressed on.
        adjust {
            display-name = "Adj";
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none        &none       &none  &none  &none  &none
&none  &bt BT_CLR    &none         &out OUT_TOG  &none         &none           &none        &none       &none  &none  &none  &none
&none  &none         &none         &none         &sys_reset    &bootloader     &bootloader  &sys_reset  &none  &none  &none  &none
                                   &none         &none         &trans          &trans       &none       &none
            >;
        };
    };
};
